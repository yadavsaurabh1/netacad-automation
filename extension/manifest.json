{
  "manifest_version": 3,
  "name": "NetAcad AutoRunner",
  "version": "1.0.0",
  "description": "Automate NetAcad course content with CCNA answer databases.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "activeTab", "downloads"],
  "host_permissions": [
    "https://www.netacad.com/*",
    "https://netacad.com/*",
    "https://*.netacad.com/*"
  ],
  "action": {
    "default_title": "NetAcad AutoRunner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netacad.com/*",
        "https://netacad.com/*",
        "https://*.netacad.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
